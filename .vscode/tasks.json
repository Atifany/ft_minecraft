{
	"version": "2.0.0",
	"tasks": [
		// Windows build task
        {
			"type": "cppbuild",
			"label": "Windows C/C++: g++.exe build active file",
			"command": "c++.exe",
			"args": [
				"-g",
				"-std=c++20",
				"-I${workspaceFolder}/include",
				"-L${workspaceFolder}/lib",
				"${workspaceFolder}/src/*.cpp",
				"${workspaceFolder}/src/glad.c",
				"-lglfw3dll",
				"-o",
				"${workspaceFolder}/bin/cutable.exe"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
		},
		// MacOS build task
		{
			"type": "cppbuild",
			"label": "MacOS C/C++: g++.exe build active file",
			"command": "/usr/bin/clang++",
			"args": [
				"-g",
				"-std=c++20",
				"-I${workspaceFolder}/include",
				"${workspaceFolder}/src/*.cpp",
				"${workspaceFolder}/src/glad.c",
				"${workspaceFolder}/lib/libglfw.3.4.dylib",
				//"-lglfw",
				"-o",
				"${workspaceFolder}/bin/cutable",
				"-framework",
				"OpenGL",
				"-framework",
				"Cocoa",
				"-framework",
				"IOKit",
				"-framework",
				"CoreVideo",
				"-framework",
				"CoreFoundation",
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
		},
    ]
}